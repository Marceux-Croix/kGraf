# Rust
/target
**/*.rs.bk

# Tauri
/src-tauri/target
/src-tauri/gen

# Node / TypeScript
node_modules/
dist/
*.tsbuildinfo
.env
.env.local

# Local index and agent state
*.db
*.db-shm
*.db-wal
/.kgraf/
# Former name of the state directory (decision 0062): a project not yet
# migrated still has it until its first run under kGraf moves it.
/.haustoria/

# macOS
.DS_Store

# Local tool state and scratch directories
.claude/
.claude_work/
.claude_todo/

# Python bytecode
__pycache__/

# Local test run output, never committed
/canary/runs/

# Local test fixtures carry their own isolated home with a skills folder;
# recordings stay local.
!/canary/fixtures/**/.claude/
/canary/cassettes/
!/canary/tests/fixtures/**/ledger.db
